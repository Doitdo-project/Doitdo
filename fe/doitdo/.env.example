API_BASE_URL=https://api.example.com

# Google OAuth — Web Server Client ID.
# Google Cloud Console 의 "웹 애플리케이션" 유형 OAuth Client ID 를 넣는다.
# 프론트와 백엔드가 이 값을 공유해야 ID Token 의 aud 가 일치해서 검증이 통과됨.
# (Client Secret 은 절대 .env 에 넣지 말 것 — 백엔드 서버에서만 사용)
GOOGLE_SERVER_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Kakao OAuth — Native App Key.
# Kakao Developers > 내 애플리케이션 > 앱 키 > "네이티브 앱 키" 값.
# Android redirect scheme (kakao{KEY}), iOS URL Scheme 도 이 값 기반 — docs/KAKAO_SETUP.md 참고.
KAKAO_NATIVE_APP_KEY=YOUR_KAKAO_NATIVE_APP_KEY
