<?xml version="1.0" encoding="utf-8"?>
<!--
  doitdo 홈 위젯 (4x2 셀).
  좌우 2단: 왼쪽 "오늘의 할 일" / 오른쪽 "언젠간 할 일".
  컬럼당 최대 4행 + 초과분 "+N개 더" 푸터.
  완료된 todo 는 표시하지 않으므로(provider 단계 필터) 취소선 처리 없음.

  RemoteViews 한계로 ListView 대신 고정 행 + visibility 토글.
  체크 아이콘 28dp — 기존 20dp 대비 약 2배 면적.
  실제 위젯 높이가 작은 런처에서는 하단 행/푸터가 자연스럽게 가려진다(clip).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- ─── 빈 상태 / 로그인 필요 안내 ─── -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:id="@+id/empty_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

    <!-- ─── 컨텐츠 (좌: 오늘 / 우: 언젠간) ─── -->
    <LinearLayout
        android:id="@+id/content_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- ═══ LEFT: 오늘의 할 일 ═══ -->
        <LinearLayout
            android:id="@+id/today_column"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="6dp">

            <!-- 헤더: ● 오늘의 할 일 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textSize="9sp"
                    android:textColor="@color/widget_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="오늘의 할 일"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text_primary" />
            </LinearLayout>

            <!-- 오늘 행 0~1 -->
            <LinearLayout
                android:id="@+id/row_today_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/check_today_0"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="todo check" />
                <TextView
                    android:id="@+id/title_today_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/widget_text_primary"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_today_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/check_today_1"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="todo check" />
                <TextView
                    android:id="@+id/title_today_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/widget_text_primary"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_today_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/check_today_2"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="todo check" />
                <TextView
                    android:id="@+id/title_today_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/widget_text_primary"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_today_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/check_today_3"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="todo check" />
                <TextView
                    android:id="@+id/title_today_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/widget_text_primary"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 빈 컬럼 안내 -->
            <TextView
                android:id="@+id/today_empty_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="할 일이 없어요"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary"
                android:visibility="gone" />

            <!-- "+N개 더" 푸터 -->
            <TextView
                android:id="@+id/today_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="10sp"
                android:textColor="@color/widget_text_secondary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ═══ DIVIDER ═══
             RemoteViews 는 base View 클래스를 inflate 하지 못함(허용 클래스 화이트리스트).
             FrameLayout 으로 동일한 1dp 세로선 효과 구현. -->
        <FrameLayout
            android:id="@+id/column_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/widget_divider" />

        <!-- ═══ RIGHT: 언젠간 할 일 ═══ -->
        <LinearLayout
            android:id="@+id/someday_column"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <!-- 헤더: ● 언젠간 할 일 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textSize="9sp"
                    android:textColor="@color/widget_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="언젠간 할 일"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text_primary" />
            </LinearLayout>

            <!-- 언젠간 행 0~1 -->
            <LinearLayout
                android:id="@+id/row_someday_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/check_someday_0"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="todo check" />
                <TextView
                    android:id="@+id/title_someday_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/widget_text_primary"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_someday_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/check_someday_1"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="todo check" />
                <TextView
                    android:id="@+id/title_someday_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/widget_text_primary"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_someday_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/check_someday_2"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="todo check" />
                <TextView
                    android:id="@+id/title_someday_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/widget_text_primary"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_someday_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/check_someday_3"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="todo check" />
                <TextView
                    android:id="@+id/title_someday_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/widget_text_primary"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 빈 컬럼 안내 -->
            <TextView
                android:id="@+id/someday_empty_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="할 일이 없어요"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary"
                android:visibility="gone" />

            <!-- "+N개 더" 푸터 -->
            <TextView
                android:id="@+id/someday_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="10sp"
                android:textColor="@color/widget_text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
