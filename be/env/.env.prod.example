spring.profiles.active=prod
db.host=mariadb
db.port=3306
db.name=doitdo_prod
db.username=doitdo_prod_user
# ⚠️ 반드시 dev (.env.dev) 와 다른 새 비밀번호. `openssl rand -base64 32` 로 생성.
db.password=change-me

# 운영 스키마 자동 변경 방지. 부팅 시 엔티티 ↔ DB 스키마 일치 검증만 하고, 실제 변경은 마이그레이션 도구로.
JPA_DDL_AUTO=validate

# JWT 서명 시크릿. 토큰 위조 방지의 핵심 — 절대 dev (.env.dev) 와 같은 값을 쓰지 말 것.
# `openssl rand -base64 64` 로 새로 생성. HMAC-SHA-256 기준 최소 256bit.
JWT_SECRET=change-me

# Firebase (FCM push) — Docker env_file 용 (env var 포맷)
# 컨테이너에 서비스 계정 JSON 을 volume 마운트 후 해당 컨테이너 내부 경로를 지정.
FIREBASE_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=doitdo-c3fcd

# Social OAuth audiences (dev 와 동일 값을 사용 — Google/Apple 모두 클라이언트 식별자라 공개되어도 OK)
GOOGLE_OAUTH_CLIENT_ID=your-google-server-client-id.apps.googleusercontent.com
APPLE_OAUTH_CLIENT_ID=com.d107.doitdo

# Apple Sign-In Key (.p8) — 회원가입 code 교환 + 회원탈퇴 revoke 의 client_secret JWT 서명용.
# .p8 파일은 호스트 /home/ubuntu/app/secrets/ 에 두고 docker-compose volume 으로 /app/secrets:ro 마운트.
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_KEY_PATH=/app/secrets/apple-signin-key.p8
APPLE_SIGNIN_CLIENT_ID=com.d107.doitdo
