spring.profiles.active=dev
db.host=168.107.48.80
db.port=3306
db.name=doitdo
db.username=doitdo_user
db.password=change-me

# (optional) Hibernate ddl-auto override. default: update
# JPA_DDL_AUTO=validate

# Google OAuth Web(Server) Client ID (used as ID Token audience)
# GOOGLE_OAUTH_CLIENT_ID=your-google-server-client-id.apps.googleusercontent.com

# (optional) 저녁 리마인더 스케줄러 on/off. default: true
# NOTIFICATION_EVENING_REMINDER_ENABLED=false

# Firebase (FCM push)
# 로컬 bootRun 용. 서비스 계정 JSON 은 be/secrets/ (gitignored) 에 배치.
# 비활성화하려면 firebase.enabled=false 또는 3줄 전체 주석.
firebase.enabled=true
firebase.service-account-path=/absolute/path/to/be/secrets/firebase-service-account-dev.json
firebase.project-id=doitdo-c3fcd
